generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model category {
  categoryID   String @id @db.VarChar(50)
  categoryName String @db.VarChar(50)
}

model count {
  countID   Int    @id
  countName String @db.VarChar(50)
}

model level {
  levelName String @db.VarChar(50)
  seq       Int    @id
  levelID   String @db.VarChar(50)
}

model time {
  timeID   Int    @id
  timeName String @db.VarChar(50)
}
